+
+    await vi.advanceTimersByTimeAsync(wallClockMs - separationMs / 2);
+    const result = await resultPromise;
+
+    expect(result, JSON.stringify(result)).toMatchObject({
+      status: "failed",
+      code: "timeout",
+      toolCallCount: 2,
+    });
+  });
